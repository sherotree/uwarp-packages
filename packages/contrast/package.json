{
  "name": "uwarp-contrast",
  "version": "0.1.0",
  "description": "WCAG 2.x relative luminance contrast ratios and AA/AAA pass/fail for foreground/background color pairs",
  "license": "MIT",
  "author": "Sherotree",
  "homepage": "https://www.uwarp.design/colour-contrast-checker",
  "repository": {
    "type": "git",
    "url": "https://github.com/sherotree/uwarp-packages.git",
    "directory": "packages/contrast"
  },
  "bugs": {
    "url": "https://github.com/sherotree/uwarp-packages/issues"
  },
  "keywords": [
    "wcag",
    "contrast",
    "accessibility",
    "a11y",
    "color",
    "uwarp"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "sideEffects": false
}
